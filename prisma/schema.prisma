generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomerPayment {
  id          String      @id @default(uuid())
  tripId      String
  amount      Float
  mode        PaymentMode
  note        String?
  createdAt   DateTime    @default(now())
  paymentDate DateTime
  type        PaymentType
  trip        Trip        @relation(fields: [tripId], references: [id])
}

model TransporterPayment {
  id          String      @id @default(uuid())
  tripId      String
  amount      Float
  mode        PaymentMode
  paymentDate DateTime
  note        String?
  createdAt   DateTime    @default(now())
  trip        Trip        @relation(fields: [tripId], references: [id])
}

model Company {
  id               String   @id @default(uuid())
  name             String
  isInternal       Boolean  @default(false)
  createdAt        DateTime @default(now())
  customerTrips    Trip[]   @relation("CustomerTrips")
  transporterTrips Trip[]   @relation("TransporterTrips")
  trucks           Truck[]
}

model Truck {
  id               String         @id @default(uuid())
  numberPlate      String         @unique
  companyId        String?
  createdAt        DateTime       @default(now())
  registrationDate DateTime?
  vehicleType      VehicleType?
  currentOdometer  Float?
  trips            Trip[]
  company          Company?       @relation(fields: [companyId], references: [id])
  truckExpenses    TruckExpense[]
}

model Expense {
  id                  String          @id @default(uuid())
  tripId              String
  category            ExpenseCategory
  amount              Float
  note                String?
  expenseDate         DateTime
  billPath            String?
  fastagPlazaCode     String?
  fastagPlazaName     String?
  fastagProcessingAt  DateTime?
  fastagTagId         String?
  fastagTransactionId String?         @unique
  trip                Trip            @relation(fields: [tripId], references: [id])
}

model TruckExpense {
  id           String               @id @default(cuid())
  truckId      String
  category     TruckExpenseCategory
  amount       Float
  vendor       String?
  expenseDate  DateTime
  month        Int
  year         Int
  createdAt    DateTime             @default(now())
  documentPath String?
  expiryDate   DateTime?
  note         String?
  truck        Truck                @relation(fields: [truckId], references: [id])

  @@index([truckId, category, expenseDate])
}

model Trip {
  id                   String               @id @default(uuid())
  truckId              String
  source               String
  destination          String
  estimatedQty         Float?
  ratePerUnit          Float?
  startDate            DateTime?
  endDate              DateTime?
  status               TripStatus           @default(PLANNED)
  createdAt            DateTime             @default(now())
  finalBalance         Float?
  finalExpenses        Float?
  finalRevenue         Float?
  closedAt             DateTime?
  closedBy             String?
  grossAmount          Float?
  revenueMode          RevenueMode          @default(FIXED)
  loadType             LoadType             @default(EXTERNAL)
  mamool               Float                @default(0)
  billNumber           String?
  charges              Float?               @default(0)
  customerAdvance      Float?               @default(0)
  customerDiesel       Float?               @default(0)
  damageAmount         Float?               @default(0)
  damageNotes          String?
  gcBalance            Float?
  tds                  Float?               @default(0)
  clientCompanyId      String?
  transporterAdvance   Float?               @default(0)
  transporterCharges   Float?               @default(0)
  transporterCompanyId String?
  transporterFreight   Float?
  transporterPayable   Float?
  commissionPerTonne   Float?               @default(0)
  freightWeight        Float?
  tripDistance         Float?
    startOdometer        Float?
  endOdometer          Float?
  gcNumber             String?
  customerPayments     CustomerPayment[]
  expenses             Expense[]
  transporterPayments  TransporterPayment[]
  clientCompany        Company?             @relation("CustomerTrips", fields: [clientCompanyId], references: [id])
  transporterCompany   Company?             @relation("TransporterTrips", fields: [transporterCompanyId], references: [id])
  truck                Truck                @relation(fields: [truckId], references: [id])
}

model ImportSession {
  id        String   @id @default(cuid())
  type      String
  data      Json
  createdAt DateTime @default(now())
}

enum TripStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum RevenueMode {
  FIXED
  VARIABLE
}

enum ExpenseCategory {
  FUEL
  TOLL
  POLICE
  LOADING
  UNLOADING
  REPAIR
  OTHER
  DRIVER_PAYMENT
}

enum TruckExpenseCategory {
  TYRE
  REPAIR
  ELECTRICAL
  INSURANCE
  ROAD_TAX
  PERMIT
  NATIONAL_PERMIT
  FITNESS
  WASHING
  ADD_BLUE
  OTHER
  FUEL
  TOLL
  LOADING
  POLICE
  DRIVER_PAYMENT
}

enum PaymentMode {
  CASH
  UPI
  BANK
}

enum PaymentType {
  ADVANCE
  SETTLEMENT
}

enum VehicleType {
  TRUCK
  TEMPO
  CAR
}

enum LoadType {
  COMPANY
  EXTERNAL
}
